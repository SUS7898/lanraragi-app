<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup and no device-to-device transfer: settings contain the server address and an
     encrypted API key bound to this device's Keystore, which would not decrypt elsewhere anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
