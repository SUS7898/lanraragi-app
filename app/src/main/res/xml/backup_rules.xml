<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9-11 backup rules (Android 12+ uses data_extraction_rules.xml). Nothing is backed up:
     the API key is bound to this device's Keystore and would be useless elsewhere. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
